/*
===========================================================================
Copyright (C) 2024 Quake3e-HD Project

Edge-aware à-trous wavelet despeckle filter for the path-traced image.

The ray generation shader writes linear HDR radiance. This filter runs as a
short chain of dilated 5x5 passes ping-ponging between the traced color
image and a scratch image:

  - the first pass demodulates surface albedo so only the noisy
    illumination signal is filtered and texture detail stays sharp,
  - middle passes filter illumination with wider taps,
  - the final pass remodulates albedo and applies tonemap + gamma so the
    image leaves the chain display-ready.

Edge-stopping weights come from the G-buffer: normals, planar depth, and
illumination luminance.
===========================================================================
*/
#version 450

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, rgba32f) uniform image2D colorImage;   // traced color / illumination
layout(set = 0, binding = 1, rgba32f) uniform image2D pingImage;    // filter scratch
layout(set = 0, binding = 2, rgba32f) uniform readonly image2D albedoImage;
layout(set = 0, binding = 3, rgba32f) uniform readonly image2D normalImage; // encoded n*0.5+0.5
layout(set = 0, binding = 4, rgba32f) uniform readonly image2D depthImage;  // .r = planar eye depth / zFar

// Pass behavior flags
const uint DENOISE_FLAG_PING_TO_COLOR = 1u;  // read ping, write color (else color -> ping)
const uint DENOISE_FLAG_DEMODULATE    = 2u;  // divide albedo out of the input
const uint DENOISE_FLAG_FINALIZE     = 4u;   // tonemap + display encode on output
const uint DENOISE_FLAG_PASSTHROUGH  = 8u;   // no filtering (single-pass path)
const uint DENOISE_FLAG_REMODULATE   = 16u;  // multiply albedo back in on output
const uint DENOISE_FLAG_BLOOM_EXTRACT = 32u; // bright-pass + horizontal blur -> ping
const uint DENOISE_FLAG_BLOOM_COMBINE = 64u; // vertical blur of ping + add back to color

layout(push_constant) uniform PushConstants {
    uint stepSize;      // à-trous dilation (1, 2, 4, ...)
    uint flags;
    float sigmaLum;     // luminance edge-stop
    float sigmaDepth;   // depth edge-stop (in depth01 units per step)
    float exposure;     // linear exposure applied before tonemapping
} pc;

const float ALBEDO_EPS = 0.003;

// B3-spline 5-tap kernel
const float kernel1D[5] = float[5](1.0 / 16.0, 4.0 / 16.0, 6.0 / 16.0, 4.0 / 16.0, 1.0 / 16.0);

float luminance(vec3 c) {
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

// Passthrough (tonemap-only) reads and writes the color image in place;
// filtering passes ping-pong according to DENOISE_FLAG_PING_TO_COLOR.
bool readsFromPing() {
    return (pc.flags & DENOISE_FLAG_PING_TO_COLOR) != 0u &&
           (pc.flags & DENOISE_FLAG_PASSTHROUGH) == 0u;
}

bool writesToColor() {
    return (pc.flags & (DENOISE_FLAG_PING_TO_COLOR | DENOISE_FLAG_PASSTHROUGH)) != 0u;
}

vec3 loadInput(ivec2 p) {
    vec3 c = readsFromPing()
        ? imageLoad(pingImage, p).rgb
        : imageLoad(colorImage, p).rgb;

    if ((pc.flags & DENOISE_FLAG_DEMODULATE) != 0u) {
        vec3 albedo = imageLoad(albedoImage, p).rgb;
        c /= max(albedo, vec3(ALBEDO_EPS));
    }
    return c;
}

void storeOutput(ivec2 p, vec3 c) {
    if ((pc.flags & DENOISE_FLAG_REMODULATE) != 0u) {
        // The chain carries demodulated illumination — multiply albedo back
        vec3 albedo = imageLoad(albedoImage, p).rgb;
        c *= max(albedo, vec3(ALBEDO_EPS));
    }

    if ((pc.flags & DENOISE_FLAG_FINALIZE) != 0u) {
        // ACES filmic (Narkowicz approximation): filmic contrast and a
        // gentle toe that keeps dark interiors readable, then sRGB encode.
        c = max(c * pc.exposure, vec3(0.0));
        c = (c * (2.51 * c + 0.03)) / (c * (2.43 * c + 0.59) + 0.14);
        c = pow(clamp(c, 0.0, 1.0), vec3(1.0 / 2.2));
    }

    if (writesToColor()) {
        imageStore(colorImage, p, vec4(c, 1.0));
    } else {
        imageStore(pingImage, p, vec4(c, 1.0));
    }
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(colorImage);

    if (coord.x >= size.x || coord.y >= size.y) {
        return;
    }

    // Bloom runs after the finalize pass, on the tonemapped display colour, as
    // a separable Gaussian: the extract pass keeps only the part of each pixel
    // above the threshold (bright emitters, muzzle flashes, lava) and blurs it
    // horizontally into ping; the combine pass blurs ping vertically and adds
    // the glow back. sigmaLum = threshold, sigmaDepth = intensity, stepSize =
    // blur spread. (17 stepped taps per axis gives a wide halo without a mip
    // chain.)
    if ((pc.flags & DENOISE_FLAG_BLOOM_EXTRACT) != 0u) {
        float threshold = pc.sigmaLum;
        int r = int(max(pc.stepSize, 1u));
        vec3 acc = vec3(0.0);
        float wsum = 0.0;
        for (int i = -8; i <= 8; i++) {
            ivec2 tap = clamp(coord + ivec2(i * r, 0), ivec2(0), size - 1);
            vec3 c = imageLoad(colorImage, tap).rgb;
            vec3 bright = max(c - vec3(threshold), vec3(0.0));
            float w = exp(-float(i * i) / 16.0);
            acc += bright * w;
            wsum += w;
        }
        imageStore(pingImage, coord, vec4(acc / max(wsum, 1e-4), 1.0));
        return;
    }
    if ((pc.flags & DENOISE_FLAG_BLOOM_COMBINE) != 0u) {
        float intensity = pc.sigmaDepth;
        int r = int(max(pc.stepSize, 1u));
        vec3 acc = vec3(0.0);
        float wsum = 0.0;
        for (int i = -8; i <= 8; i++) {
            ivec2 tap = clamp(coord + ivec2(0, i * r), ivec2(0), size - 1);
            vec3 c = imageLoad(pingImage, tap).rgb;
            float w = exp(-float(i * i) / 16.0);
            acc += c * w;
            wsum += w;
        }
        vec3 bloom = acc / max(wsum, 1e-4);
        vec3 base = imageLoad(colorImage, coord).rgb;
        imageStore(colorImage, coord, vec4(base + bloom * intensity, 1.0));
        return;
    }

    if ((pc.flags & DENOISE_FLAG_PASSTHROUGH) != 0u) {
        storeOutput(coord, loadInput(coord));
        return;
    }

    vec3 centerIllum = loadInput(coord);
    vec3 centerNormal = imageLoad(normalImage, coord).rgb * 2.0 - 1.0;
    float centerDepth = imageLoad(depthImage, coord).r;
    float centerLum = luminance(centerIllum);

    // Sky/far pixels are noise-free; filtering them only softens silhouettes
    if (centerDepth >= 0.999) {
        storeOutput(coord, centerIllum);
        return;
    }

    // Estimate the local luminance statistics (undilated 3x3) to drive the
    // luminance edge-stop. This is the key SVGF idea: where the illumination is
    // noisy the variance is high, so tolerate large luminance differences and
    // smooth hard; where it is already clean the stop stays tight so lighting
    // boundaries survive. Geometry edges are protected separately by the
    // normal/depth stops, so this only trades a little shadow-edge sharpness
    // for a large drop in grain. The mean also gives a firefly reference.
    float m1 = 0.0, m2 = 0.0;
    for (int vy = -1; vy <= 1; vy++) {
        for (int vx = -1; vx <= 1; vx++) {
            ivec2 vp = clamp(coord + ivec2(vx, vy), ivec2(0), size - 1);
            float l = luminance(loadInput(vp));
            m1 += l;
            m2 += l * l;
        }
    }
    m1 *= (1.0 / 9.0);
    float lumStdDev = sqrt(max(m2 * (1.0 / 9.0) - m1 * m1, 0.0));
    // Variance-guided tolerance plus a small floor so fully converged flats
    // still lose their last speckle.
    float lumSigma = pc.sigmaLum * lumStdDev + 0.02;

    // Firefly suppression: a lone sample far above the local mean is a path
    // spike, not signal. Clamp the center's luminance so the filter doesn't
    // spread it into a blob.
    float fireflyMax = m1 + 3.0 * lumStdDev + 0.05;
    if (centerLum > fireflyMax && centerLum > 1e-4) {
        centerIllum *= fireflyMax / centerLum;
        centerLum = fireflyMax;
    }

    int step = int(max(pc.stepSize, 1u));
    vec3 sum = vec3(0.0);
    float weightSum = 0.0;

    for (int dy = -2; dy <= 2; dy++) {
        for (int dx = -2; dx <= 2; dx++) {
            ivec2 tap = coord + ivec2(dx, dy) * step;
            if (tap.x < 0 || tap.y < 0 || tap.x >= size.x || tap.y >= size.y) {
                continue;
            }

            vec3 tapIllum = loadInput(tap);
            vec3 tapNormal = imageLoad(normalImage, tap).rgb * 2.0 - 1.0;
            float tapDepth = imageLoad(depthImage, tap).r;

            float w = kernel1D[dx + 2] * kernel1D[dy + 2];

            // Geometry edges: normals must agree
            float wNormal = pow(max(dot(centerNormal, tapNormal), 0.0), 32.0);

            // Depth edges: reject taps across depth discontinuities
            float depthDiff = abs(centerDepth - tapDepth);
            float wDepth = exp(-depthDiff / max(pc.sigmaDepth * float(step), 1e-6));

            // Variance-guided luminance edge-stop: in noisy regions lumSigma
            // is large (smooth through the noise); in clean regions it is tiny
            // (keep lighting boundaries crisp).
            float tapLum = luminance(tapIllum);
            // Clamp firefly taps to the local envelope too.
            if (tapLum > fireflyMax && tapLum > 1e-4) {
                tapIllum *= fireflyMax / tapLum;
                tapLum = fireflyMax;
            }
            float lumDiff = abs(centerLum - tapLum);
            float wLum = exp(-lumDiff / lumSigma);

            w *= wNormal * wDepth * wLum;

            sum += tapIllum * w;
            weightSum += w;
        }
    }

    vec3 result = (weightSum > 1e-6) ? (sum / weightSum) : centerIllum;
    storeOutput(coord, result);
}
