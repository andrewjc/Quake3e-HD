/*
===========================================================================
Copyright (C) 2024 Quake3e-HD Project

Depth-aware composite of rasterized dynamic content over the path-traced
world. The tracer covers world geometry only; entities (players, items,
view weapon) are rasterized. Any raster pixel that is clearly in front of
the traced world surface keeps its rasterized color; everything else shows
the path-traced result.

Runs on the traced color image in place, before it is blitted over the
offscreen color target.
===========================================================================
*/
#version 450

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, rgba32f) uniform image2D tracedColor;
layout(set = 0, binding = 1, rgba32f) uniform readonly image2D tracedDepth; // .r = planar eye depth / zFar
layout(set = 0, binding = 2) uniform sampler2D rasterColor;
layout(set = 0, binding = 3) uniform sampler2D rasterDepth;
// Volumetric media along the traced primary ray: rgb = linear in-scatter,
// a = transmittance (fog + explosion/smoke volumes)
layout(set = 0, binding = 4, rgba32f) uniform readonly image2D mediaImage;

layout(push_constant) uniform PushConstants {
    float zNear;
    float zFar;
    float depthBiasScale;   // relative tolerance, e.g. 0.997
    float depthBiasOffset;  // absolute tolerance in world units
    float exposure;         // matches the denoiser's tonemap exposure
    float pad0;
} pc;

/*
================
Depth-aware 5x5 filter over the media buffer. The volumetric march is
dithered with interleaved gradient noise (1-2 px wavelength) and its sun
shadow rays are single-tap, so raw media carries structured grain; this
tent filter removes it while the depth weight keeps haze from bleeding
across silhouettes. Volume features themselves are soft, so the blur costs
no real detail.
================
*/
vec4 sampleMediaFiltered(ivec2 coord, ivec2 size, float centerDepth) {
    const float kernel[5] = float[](0.0625, 0.25, 0.375, 0.25, 0.0625);
    vec4 acc = vec4(0.0);
    float wsum = 0.0;

    for (int dy = -2; dy <= 2; dy++) {
        for (int dx = -2; dx <= 2; dx++) {
            ivec2 c = clamp(coord + ivec2(dx, dy), ivec2(0), size - 1);
            float d = imageLoad(tracedDepth, c).r;
            float wd = exp(-abs(d - centerDepth) / 0.015);
            float w = kernel[dx + 2] * kernel[dy + 2] * wd;
            acc += imageLoad(mediaImage, c) * w;
            wsum += w;
        }
    }
    return acc / max(wsum, 1e-5);
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(tracedColor);

    if (coord.x >= size.x || coord.y >= size.y) {
        return;
    }

    vec2 uv = (vec2(coord) + 0.5) / vec2(size);

    float tracedZ01 = imageLoad(tracedDepth, coord).r;
    float eyeTraced = tracedZ01 * pc.zFar;

    // The engine uses reversed depth (near = 1, far = 0, cleared to 0)
    float dRaster = texture(rasterDepth, uv).r;

    // Choose the base pixel: rasterized content only when it is
    // unambiguously in front of the traced world surface (entities, view
    // weapon, pickups); otherwise the denoised traced result.
    vec3 base = imageLoad(tracedColor, coord).rgb;
    bool rasterWon = false;
    float mediaRatio = 1.0;
    if (dRaster > 0.0) {
        // Reversed [0,1] depth back to eye-space distance along the view axis
        float eyeRaster = (pc.zNear * pc.zFar) / (pc.zNear + dRaster * (pc.zFar - pc.zNear));
        if (eyeRaster < eyeTraced * pc.depthBiasScale - pc.depthBiasOffset) {
            base = texture(rasterColor, uv).rgb;
            rasterWon = true;
            // The media was integrated out to the traced surface; scale it
            // by the depth ratio so entities inside or behind smoke dim
            // correctly while entities well in front of it stay clean.
            mediaRatio = clamp(eyeRaster / max(eyeTraced, 1e-3), 0.0, 1.0);
        }
    }

    // Volumetric media (fog, explosion fireballs, smoke) is applied here,
    // AFTER the denoiser so the a-trous chain cannot smear volume shapes;
    // the dedicated depth-aware filter above removes the march dither
    vec4 media = sampleMediaFiltered(coord, size, tracedZ01);
    float trans = pow(clamp(media.a, 0.0, 1.0), mediaRatio);
    vec3 scatter = max(media.rgb, vec3(0.0)) * mediaRatio;

    if (trans >= 0.9999 && scatter == vec3(0.0)) {
        if (rasterWon) {
            imageStore(tracedColor, coord, vec4(base, 1.0));
        }
        return;
    }

    // Both base images are display-referred: attenuation maps exactly via
    // trans^(1/2.2); the in-scatter goes through the same ACES + sRGB as
    // the surface path so glows match everywhere.
    vec3 s = scatter * pc.exposure;
    s = (s * (2.51 * s + 0.03)) / (s * (2.43 * s + 0.59) + 0.14);
    s = pow(clamp(s, vec3(0.0), vec3(1.0)), vec3(1.0 / 2.2));

    vec3 outColor = base * pow(trans, 1.0 / 2.2) + s;
    imageStore(tracedColor, coord, vec4(outColor, 1.0));
}
