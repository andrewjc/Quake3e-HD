/*
===========================================================================
Copyright (C) 2024 Quake3e-HD Project

RTX Ray Generation Shader

Owns the full lighting integration: primary rays, iterative GI bounces,
the direct light loop (grid-culled static lights plus linear dynamic
lights) and shadow rays. Hit shaders never trace, so the pipeline runs at
recursion depth 1.
===========================================================================
*/

#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_nonuniform_qualifier : enable
#extension GL_EXT_scalar_block_layout : enable
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_buffer_reference2 : require

layout(binding = 0, set = 0) uniform accelerationStructureEXT topLevelAS;
layout(binding = 1, set = 0, rgba32f) uniform image2D image;
layout(binding = 2, set = 0, rgba32f) uniform image2D albedoImage;
layout(binding = 3, set = 0, rgba32f) uniform image2D normalImage;
layout(binding = 4, set = 0, rgba32f) uniform image2D motionVectorImage;
layout(binding = 5, set = 0, rgba32f) uniform image2D depthImage;

// Lighting contribution buffers for debug visualization
layout(binding = 15, set = 0, rgba32f) uniform image2D directLightImage;
layout(binding = 16, set = 0, rgba32f) uniform image2D indirectLightImage;

layout(binding = 6, set = 0) uniform CameraBuffer {
    mat4 viewInverse;
    mat4 projInverse;
    vec3 position;
    float time;
    vec3 forward;
    float fov;
    vec3 right;
    float nearPlane;
    vec3 up;
    float farPlane;
    vec2 jitter;
    vec2 previousJitter;
    mat4 previousViewProjection;
    uint frameCount;
    uint enablePathTracing;
    uint maxBounces;
    uint samplesPerPixel;
} cam;

layout(binding = 7, set = 0) uniform RenderSettings {
    uint enableShadows;
    uint enableReflections;
    uint enableGI;
    uint enableAO;
    float shadowBias;
    float reflectionRoughnessCutoff;
    float giIntensity;
    float aoRadius;
    uint debugMode;
    uint enableDenoiser;
    uint enableDLSS;
    uint enableMotionBlur;
    vec4 lightGridOrigin;
    vec4 lightGridCellSize;
    vec4 lightGridInvCellSize;
    uvec4 lightGridDims;
    uvec4 lightGridCounts;
    vec4 skyAmbient;        // rgb = color, a = intensity
    vec4 volumetricParams;  // x = density/unit, y = anisotropy g, z = max march dist, w = enable
    vec4 featureParams;     // x = caustics enable, y = caustic intensity
    vec4 shadowParams;      // x = soft shadows enable, y = point light radius scale,
                            // z = sun angular radius (radians), w = spare
} settings;

layout(binding = 18, set = 0) uniform DebugSettings {
    uint noTextures;
    uint debugMode;
    float debugOverlayBlend;
    uint debugFlags;
} debugSettings;

// Volumetric weapon effects: explosion fireballs and smoke replacing the
// cgame sprite animations, ray-marched as participating media
struct VolumeFx {
    vec4 posRadius;   // xyz = world center, w = radius
    vec4 emission;    // rgb = fire tint / smoke albedo, w = class id
    vec4 params;      // x = age s, y = life fraction, z = seed, w = fire/smoke boundary fraction
};

layout(binding = 13, set = 0) uniform VolumeFXBuffer {
    uvec4 countPad;   // x = active count
    VolumeFx fx[64];
} volumeFX;

// Media along the primary ray (rgb = in-scatter, a = transmittance): the
// depth-aware composite uses this to fog/glow rasterized entities
layout(binding = 17, set = 0, rgba32f) uniform image2D mediaImage;

#define VFX_CLASS_EXPLOSION 1
#define VFX_CLASS_IMPACT    2
#define VFX_CLASS_PLASMA    3
#define VFX_CLASS_RAIL      4
#define VFX_CLASS_BFG       5
#define VFX_CLASS_SMOKE     6
#define VFX_CLASS_GUNSMOKE  7

// Light data
struct Light {
    vec4 position;    // w = type (0=directional, 1=point, 2=spot)
    vec4 direction;   // w = inner cone cos for spot
    vec4 color;       // w = intensity
    vec4 attenuation; // x=constant, y=linear (2/radius), z=quadratic (1/r^2), w=outer cone cos
};

layout(binding = 14, set = 0, scalar) buffer LightBuffer {
    uint numLights;
    Light lights[];
} lightData;

// Light grid: spatial index over the static prefix of the light array.
// offsets[] holds cellCount+1 prefix sums into the per-cell region of
// indices[]; indices[] starts with directionalCount directional lights,
// followed by the per-cell light index lists.
layout(binding = 21, set = 0, scalar) buffer LightGridOffsets {
    uint offsets[];
} lightGridOffsets;

layout(binding = 22, set = 0, scalar) buffer LightGridIndices {
    uint indices[];
} lightGridIndices;

// Ray payload for surface rays (written by closest-hit / miss)
layout(location = 0) rayPayloadEXT struct HitInfo {
    vec3 color;
    float distance;
    vec3 normal;
    float roughness;
    vec3 albedo;
    float metallic;
    vec3 worldPos;
    uint materialID;
    vec2 uv;
    uint primitiveID;
    uint instanceID;
    uint hitType; // 0 = miss, 1 = hit
} hitInfo;

// Shadow ray payload: 1.0 = unoccluded, 0.0 = shadowed
layout(location = 1) rayPayloadEXT float shadowPayload;

// Constants
const float PI = 3.14159265359;
const float INV_PI = 0.31830988618;
const float EPSILON = 0.005;

// Random number generation using PCG hash
uint pcgHash(uint seed) {
    uint state = seed * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

float randomFloat(inout uint seed) {
    seed = pcgHash(seed);
    return float(seed) / 4294967296.0;
}

vec3 sampleHemisphere(vec3 normal, inout uint seed) {
    float phi = 2.0 * PI * randomFloat(seed);
    float cosTheta = sqrt(randomFloat(seed)); // Cosine weighted
    float sinTheta = sqrt(1.0 - cosTheta * cosTheta);

    vec3 tangent = normalize(abs(normal.x) > 0.1 ? vec3(0, 1, 0) : vec3(1, 0, 0));
    tangent = normalize(cross(normal, tangent));
    vec3 bitangent = cross(normal, tangent);

    return tangent * (sinTheta * cos(phi)) + bitangent * (sinTheta * sin(phi)) + normal * cosTheta;
}

float luminanceRGB(vec3 c) {
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

// Importance-sample a GGX microfacet half-vector from the distribution of
// *visible* normals (Heitz 2018). This is what turns the diffuse-only bounce
// into real glossy/mirror reflections: sampling the VNDF makes the reflection
// estimator low-variance, and the throughput weight for the reflected ray
// collapses to F * G1(L) (see the bounce loop).
vec3 sampleGGXVNDF(vec3 N, vec3 V, float roughness, inout uint seed) {
    // Tangent frame around the shading normal
    vec3 T = normalize(abs(N.x) > 0.1 ? vec3(0, 1, 0) : vec3(1, 0, 0));
    T = normalize(cross(N, T));
    vec3 B = cross(N, T);

    // View in tangent space, stretched by roughness
    vec3 Ve = vec3(dot(V, T), dot(V, B), dot(V, N));
    float alpha = max(roughness * roughness, 1e-4);
    vec3 Vh = normalize(vec3(alpha * Ve.x, alpha * Ve.y, Ve.z));

    // Orthonormal basis on the hemisphere disk (Heitz)
    float lensq = Vh.x * Vh.x + Vh.y * Vh.y;
    vec3 T1 = lensq > 0.0 ? vec3(-Vh.y, Vh.x, 0.0) * inversesqrt(lensq) : vec3(1, 0, 0);
    vec3 T2 = cross(Vh, T1);

    // Uniform disk sample, warped to the projected area
    float u1 = randomFloat(seed);
    float u2 = randomFloat(seed);
    float r = sqrt(u1);
    float phi = 2.0 * PI * u2;
    float t1 = r * cos(phi);
    float t2 = r * sin(phi);
    float s = 0.5 * (1.0 + Vh.z);
    t2 = (1.0 - s) * sqrt(max(0.0, 1.0 - t1 * t1)) + s * t2;

    vec3 Nh = t1 * T1 + t2 * T2 + sqrt(max(0.0, 1.0 - t1 * t1 - t2 * t2)) * Vh;
    // Unstretch back to the ellipsoid, then to world space
    vec3 Ne = normalize(vec3(alpha * Nh.x, alpha * Nh.y, max(1e-6, Nh.z)));
    return normalize(Ne.x * T + Ne.y * B + Ne.z * N);
}

// Windowed physically based falloff: inverse-square core with a smooth
// cutoff at the light radius so lights have finite influence like the
// engine's light culling expects. The near field is clamped to a fraction
// of the radius — Quake light entities sit almost on the walls, and a pure
// point falloff would blow the adjacent texels out; treating the source as
// a small sphere caps its peak surface radiance.
float computeAttenuation(float dist, vec3 attenuation) {
    float att;

    if (attenuation.y > 0.0) {
        float radius = 2.0 / attenuation.y;
        float effDist = max(dist, radius * 0.15);

        float denom = attenuation.x + attenuation.y * effDist + attenuation.z * effDist * effDist;
        att = 1.0 / max(denom, 1e-4);

        float ratio = dist / radius;
        float ratio2 = ratio * ratio;
        float window = clamp(1.0 - ratio2 * ratio2, 0.0, 1.0);
        att *= window * window;
    } else {
        float denom = attenuation.x + attenuation.z * dist * dist;
        att = 1.0 / max(denom, 1e-4);
    }

    return att;
}

vec3 fresnelSchlick(float cosTheta, vec3 F0) {
    return F0 + (1.0 - F0) * pow(1.0 - cosTheta, 5.0);
}

float distributionGGX(vec3 N, vec3 H, float roughness) {
    float a = roughness * roughness;
    float a2 = a * a;
    float NdotH = max(dot(N, H), 0.0);
    float NdotH2 = NdotH * NdotH;

    float num = a2;
    float denom = (NdotH2 * (a2 - 1.0) + 1.0);
    denom = PI * denom * denom;

    return num / denom;
}

float geometrySchlickGGX(float NdotV, float roughness) {
    float r = (roughness + 1.0);
    float k = (r * r) / 8.0;

    return NdotV / (NdotV * (1.0 - k) + k);
}

float geometrySmith(vec3 N, vec3 V, vec3 L, float roughness) {
    float NdotV = max(dot(N, V), 0.0);
    float NdotL = max(dot(N, L), 0.0);
    return geometrySchlickGGX(NdotV, roughness) * geometrySchlickGGX(NdotL, roughness);
}

vec3 calculatePBR(vec3 albedo, float metallic, float roughness, vec3 normal, vec3 viewDir, vec3 lightDir, vec3 lightColor) {
    vec3 H = normalize(viewDir + lightDir);
    vec3 F0 = mix(vec3(0.04), albedo, metallic);

    // Cook-Torrance BRDF
    float NDF = distributionGGX(normal, H, roughness);
    float G = geometrySmith(normal, viewDir, lightDir, roughness);
    vec3 F = fresnelSchlick(max(dot(H, viewDir), 0.0), F0);

    vec3 kD = (vec3(1.0) - F) * (1.0 - metallic);

    vec3 numerator = NDF * G * F;
    float denominator = 4.0 * max(dot(normal, viewDir), 0.0) * max(dot(normal, lightDir), 0.0) + 0.001;
    vec3 specular = numerator / denominator;

    float NdotL = max(dot(normal, lightDir), 0.0);
    return (kD * albedo / PI + specular) * lightColor * NdotL;
}

// Trace a shadow ray toward the light; returns 1.0 when unoccluded.
// Uses the dedicated shadow miss shader (index 1) and never invokes
// closest-hit for occluders.
float traceShadowRay(vec3 origin, vec3 dir, float maxDist) {
    shadowPayload = 0.0;
    traceRayEXT(topLevelAS,
                gl_RayFlagsTerminateOnFirstHitEXT |
                gl_RayFlagsOpaqueEXT |
                gl_RayFlagsSkipClosestHitShaderEXT,
                0xff,
                0,      // sbtRecordOffset
                0,      // sbtRecordStride
                1,      // missIndex (shadow miss)
                origin, 0.01, dir, maxDist, 1);
    return shadowPayload;
}

// Soft shadows: sample a point on the light's area (a sphere for local lights,
// a disc for the sun) instead of its centre, so the shadow ray traces toward a
// slightly different point each frame. The temporal + variance denoiser then
// resolves the jittered occlusion into a smooth penumbra that widens with
// distance from the occluder (contact hardening) for free.
vec3 sampleShadowDirection(Light light, vec3 worldPos, vec3 lightDir,
                           inout float sdist, inout uint seed) {
    // Orthonormal frame around the direction to the light
    vec3 up = abs(lightDir.x) > 0.9 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    vec3 T = normalize(up - lightDir * dot(up, lightDir));
    vec3 B = cross(lightDir, T);
    // Concentric disc sample
    float r = sqrt(randomFloat(seed));
    float ang = 2.0 * PI * randomFloat(seed);
    vec3 offset = (T * cos(ang) + B * sin(ang)) * r;

    if (light.position.w == 0.0) {
        // Directional (sun): perturb within the sun's angular radius
        return normalize(lightDir + offset * settings.shadowParams.z);
    }
    // Point / spot: sample a disc of the light's physical radius at its origin.
    // attenuation.y = 2/influenceRadius, so the influence radius is 2/att.y and
    // the emitter's physical size is a fraction of that (shadowParams.y).
    float influence = (light.attenuation.y > 1e-4) ? (2.0 / light.attenuation.y) : 100.0;
    float radius = influence * settings.shadowParams.y;
    vec3 pt = light.position.xyz + offset * radius;
    vec3 toPt = pt - worldPos;
    sdist = length(toPt) - 0.5;
    return normalize(toPt);
}

// Direct lighting at a surface point: grid-culled static lights plus the
// linear dynamic tail, each with a shadow ray when it contributes.
vec3 shadeDirectLighting(vec3 worldPos, vec3 normal, vec3 albedo,
                         float roughness, float metallic, vec3 viewDir,
                         inout uint seed) {
    vec3 color = vec3(0.0);
    vec3 shadowOrigin = worldPos + normal * 0.1;

    uint dynamicStart = settings.lightGridCounts.w;
    uint cellCount = settings.lightGridDims.w;
    bool useGrid = (cellCount > 0u) && (settings.lightGridCounts.y > cellCount);

    uint cellBase = 0u;
    uint cellEnd = 0u;
    uint dirCount = 0u;
    if (useGrid) {
        vec3 rel = (worldPos - settings.lightGridOrigin.xyz) * settings.lightGridInvCellSize.xyz;
        uvec3 dims = settings.lightGridDims.xyz;
        ivec3 cell = ivec3(clamp(rel, vec3(0.0), vec3(dims) - 1.0));
        uint cellIndex = (uint(cell.z) * dims.y + uint(cell.y)) * dims.x + uint(cell.x);
        dirCount = settings.lightGridCounts.x;
        cellBase = dirCount + lightGridOffsets.offsets[cellIndex];
        cellEnd = dirCount + lightGridOffsets.offsets[cellIndex + 1u];
    } else {
        // No grid: shade the whole static prefix linearly
        cellBase = 0u;
        cellEnd = dynamicStart;
    }

    // Directional statics + this cell's statics + all dynamics
    uint totalIterations = dirCount + (cellEnd - cellBase) +
                           (lightData.numLights - min(dynamicStart, lightData.numLights));

    for (uint iter = 0u; iter < totalIterations; iter++) {
        uint i;
        if (iter < dirCount) {
            i = lightGridIndices.indices[iter];
        } else if (iter < dirCount + (cellEnd - cellBase)) {
            i = useGrid ? lightGridIndices.indices[cellBase + (iter - dirCount)]
                        : (iter - dirCount);
        } else {
            i = dynamicStart + (iter - dirCount - (cellEnd - cellBase));
        }
        if (i >= lightData.numLights) {
            continue;
        }

        Light light = lightData.lights[i];
        vec3 lightDir;
        float attenuation = 1.0;
        float shadowDist = 10000.0;

        if (light.position.w == 0.0) {
            // Directional light
            lightDir = normalize(-light.direction.xyz);
        } else {
            vec3 toLight = light.position.xyz - worldPos;
            float dist = length(toLight);
            if (dist < 1e-3) {
                continue;
            }
            lightDir = toLight / dist;
            shadowDist = dist - 0.5;
            attenuation = computeAttenuation(dist, light.attenuation.xyz);

            if (light.position.w == 2.0) {
                // Spot cone falloff
                float theta = dot(lightDir, normalize(-light.direction.xyz));
                float epsilon = light.direction.w - light.attenuation.w; // inner - outer
                float coneIntensity = clamp((theta - light.attenuation.w) / max(epsilon, 1e-4), 0.0, 1.0);
                attenuation *= coneIntensity;
            }
        }

        float NdotL = dot(normal, lightDir);
        if (NdotL <= 0.0) {
            continue;
        }

        vec3 lightColor = light.color.rgb * light.color.a * attenuation;
        if (max(lightColor.r, max(lightColor.g, lightColor.b)) * NdotL < 0.002) {
            continue;
        }

        // Shadow tMax must exceed the ray's tMin or the trace is invalid;
        // lights closer than that to the surface simply skip occlusion.
        if (settings.enableShadows != 0u && shadowDist > 0.05) {
            vec3 shadowDir = lightDir;
            float sDist = shadowDist;
            // Soft shadows: jitter the ray across the light's area (penumbra).
            if (settings.shadowParams.x > 0.5) {
                shadowDir = sampleShadowDirection(light, worldPos, lightDir, sDist, seed);
            }
            if (sDist > 0.05) {
                float visibility = traceShadowRay(shadowOrigin, shadowDir, sDist);
                if (visibility <= 0.0) {
                    continue;
                }
                lightColor *= visibility;
            }
        }

        color += calculatePBR(albedo, metallic, roughness, normal, viewDir, lightDir, lightColor);
    }

    return color;
}

/*
================
Animated caustic interference pattern for underwater surfaces: layered
moving waves whose ridges approximate focused refraction bands.
================
*/
float causticPattern(vec3 worldPos, float t) {
    vec2 uv = worldPos.xy * 0.021;

    float a = sin(uv.x * 1.7 + uv.y * 2.3 + t * 1.05);
    float b = sin(uv.x * 2.9 - uv.y * 1.3 - t * 1.35 + 1.7);
    float c = sin(-uv.x * 1.1 + uv.y * 3.1 + t * 0.85 + 4.1);

    float k = a + b + c;
    // Sharpen the interference maxima into caustic ridges
    float ridges = pow(clamp(0.5 + 0.5 * k * 0.4, 0.0, 1.0), 5.0);
    return ridges;
}

/*
================
Cheap 3D value noise for volumetric effect shaping (no transcendentals in
the hash — this runs up to ~80 times per pixel inside effect volumes)
================
*/
float vfxHash(vec3 p) {
    p = fract(p * 0.3183099 + vec3(0.1, 0.2, 0.3));
    p *= 17.0;
    return fract(p.x * p.y * p.z * (p.x + p.y + p.z));
}

float vfxNoise(vec3 p) {
    vec3 i = floor(p);
    vec3 f = fract(p);
    vec3 u = f * f * (3.0 - 2.0 * f);
    return mix(mix(mix(vfxHash(i + vec3(0, 0, 0)), vfxHash(i + vec3(1, 0, 0)), u.x),
                   mix(vfxHash(i + vec3(0, 1, 0)), vfxHash(i + vec3(1, 1, 0)), u.x), u.y),
               mix(mix(vfxHash(i + vec3(0, 0, 1)), vfxHash(i + vec3(1, 0, 1)), u.x),
                   mix(vfxHash(i + vec3(0, 1, 1)), vfxHash(i + vec3(1, 1, 1)), u.x), u.y), u.z);
}

float vfxFbm(vec3 p) {
    float v = 0.0;
    float amp = 0.55;
    for (int i = 0; i < 4; i++) {
        v += amp * vfxNoise(p);
        p = p * 2.13 + vec3(11.3, 7.1, 5.7);
        amp *= 0.5;
    }
    return v;
}

// Two-octave variant for the self-shadow taps (runs 2x per march step)
float vfxFbm2(vec3 p) {
    return 0.62 * vfxNoise(p) + 0.34 * vfxNoise(p * 2.13 + vec3(11.3, 7.1, 5.7));
}

/*
================
Volume effect density field.

Domain-warped FBM carved by a spherical shell: the warp rolls the interior
into cauliflower billows and displaces the boundary so the volume reads as
a cluster of lobes instead of a ball. The tear threshold rises with age,
dissolving the field into wisps. The full version also returns the raw
noise value for heat modulation; the cheap version feeds self-shadow taps.
================
*/
float vfxField(vec3 local, vec3 noiseLocal, vec3 drift, float domainScale,
               float tear, out float outNoise) {
    float q = vfxNoise(noiseLocal * domainScale * 0.8 + drift * 0.6 + vec3(5.2));
    vec3 wp = noiseLocal * domainScale + drift + vec3(q - 0.5) * 1.7;
    float n = vfxFbm(wp);
    outNoise = n;
    float radial = length(local) * (1.0 + 0.45 * (q - 0.5));
    float shell = smoothstep(1.0, 0.32, radial);
    return shell * smoothstep(tear, tear + 0.28, n + shell * 0.30);
}

float vfxFieldCheap(vec3 local, vec3 drift, float domainScale, float tear) {
    float n = vfxFbm2(local * domainScale + drift);
    float shell = smoothstep(1.0, 0.38, length(local));
    return shell * smoothstep(tear, tear + 0.28, n + shell * 0.30);
}

/*
================
Fire color ramps. Combustion classes follow a blackbody-style gradient
(white core -> yellow -> orange -> deep red edge, shifted by the class
tint); energy classes (plasma, rail, bfg) ramp from a dim tint to a
white-hot version of the tint instead of through orange.
================
*/
vec3 vfxFireRamp(float heat, vec3 tint) {
    vec3 cWhite = vec3(1.0, 0.97, 0.88);
    vec3 cMid   = mix(vec3(1.0, 0.62, 0.18), tint, 0.35);
    vec3 cLow   = mix(vec3(0.72, 0.16, 0.02), tint * 0.55, 0.45);
    vec3 cEdge  = vec3(0.16, 0.02, 0.0);
    vec3 c = mix(cEdge, cLow, smoothstep(0.0, 0.35, heat));
    c = mix(c, cMid, smoothstep(0.30, 0.68, heat));
    c = mix(c, cWhite, smoothstep(0.72, 0.95, heat));
    return c;
}

vec3 vfxEnergyRamp(float heat, vec3 tint) {
    vec3 c = tint * (0.25 + 0.75 * heat);
    return mix(c, vec3(1.0, 1.0, 1.0) * max(max(tint.r, tint.g), tint.b),
               smoothstep(0.7, 0.97, heat) * 0.7);
}

/*
================
March one volumetric weapon effect along the primary ray.

Explosions: an expanding noise-torn fireball whose blackbody-style emission
cools from white-hot core to the class tint, then hands over to a rising,
dissipating smoke shell lit by the sun, sky ambient, and dynamic lights.
Smoke puffs: pure lit media that rise, billow, and tear apart with age.
Returns in-scattered radiance; transmittance via outTrans.
================
*/
vec3 marchVolumeEffect(int fxIndex, vec3 origin, vec3 dir, float tMax, float ign,
                       out float outTrans) {
    outTrans = 1.0;

    VolumeFx v = volumeFX.fx[fxIndex];
    int classId = int(v.emission.w + 0.5);
    float age = v.params.x;
    float life = clamp(v.params.y, 0.0, 1.0);
    float seed = v.params.z * 37.0;
    float fireFrac = v.params.w;

    // How far the effect has progressed past its emissive phase (0 during
    // fire, ->1 across the smoke linger)
    float smokePhase = (fireFrac < 0.999)
        ? clamp((life - fireFrac) / max(1.0 - fireFrac, 1e-3), 0.0, 1.0)
        : life;
    // Fire intensity: full at spawn, dies at the fire/smoke boundary
    float fireT = (fireFrac > 1e-3) ? clamp(1.0 - life / fireFrac, 0.0, 1.0) : 0.0;

    // Animated placement: fireballs expand rapidly then drift; smoke rises
    vec3 center = v.posRadius.xyz;
    float radius = v.posRadius.w;
    bool isSmokeClass = (classId == VFX_CLASS_SMOKE || classId == VFX_CLASS_GUNSMOKE);
    if (isSmokeClass) {
        center.z += 26.0 * age;
        radius *= 0.55 + 0.85 * life;
    } else {
        radius *= 0.30 + 0.70 * smoothstep(0.0, 0.22, life) + 0.45 * smokePhase;
        center.z += 34.0 * smokePhase * smokePhase * age;
    }

    // Ray / sphere intersection
    vec3 oc = origin - center;
    float b = dot(oc, dir);
    float c = dot(oc, oc) - radius * radius;
    float disc = b * b - c;
    if (disc <= 0.0) {
        return vec3(0.0);
    }
    float sq = sqrt(disc);
    float t0 = max(-b - sq, 0.05);
    float t1 = min(-b + sq, tMax);
    if (t1 <= t0) {
        return vec3(0.0);
    }

    // Per-class media density (per world unit at full field strength) and
    // emissive power
    float sigmaScale;
    float emissivePower;
    if (classId == VFX_CLASS_EXPLOSION)      { sigmaScale = 0.045; emissivePower = 12.0; }
    else if (classId == VFX_CLASS_IMPACT)    { sigmaScale = 0.040; emissivePower = 7.0;  }
    else if (classId == VFX_CLASS_PLASMA)    { sigmaScale = 0.038; emissivePower = 9.0;  }
    else if (classId == VFX_CLASS_RAIL)      { sigmaScale = 0.038; emissivePower = 7.0;  }
    else if (classId == VFX_CLASS_BFG)       { sigmaScale = 0.042; emissivePower = 11.0; }
    else if (classId == VFX_CLASS_GUNSMOKE)  { sigmaScale = 0.012; emissivePower = 0.0;  }
    else                                     { sigmaScale = 0.020; emissivePower = 0.0;  }

    bool isEnergy = (classId == VFX_CLASS_PLASMA || classId == VFX_CLASS_RAIL ||
                     classId == VFX_CLASS_BFG);

    // Emissive volumes get a finer march — they carry the detail
    int FX_STEPS = (emissivePower > 0.0) ? 20 : 14;
    float stepLen = (t1 - t0) / float(FX_STEPS);

    // Smoke fades out across the linger phase
    float smokeDensityFade = (emissivePower > 0.0)
        ? (1.0 - 0.85 * smokePhase)
        : (1.0 - life * life);

    // Detonation flash: a short, hard overbright front right at spawn
    float flash = 1.0 + 6.0 * clamp(1.0 - age / 0.07, 0.0, 1.0);

    // Sun: one visibility ray at the segment midpoint (per effect, not per
    // step — media is forgiving and this keeps the march affordable)
    bool haveSun = settings.lightGridCounts.x > 0u;
    vec3 sunDir = vec3(0.0, 0.0, 1.0);
    vec3 sunRadiance = vec3(0.0);
    if (haveSun) {
        Light sun = lightData.lights[lightGridIndices.indices[0]];
        sunDir = normalize(-sun.direction.xyz);
        vec3 midP = origin + dir * (0.5 * (t0 + t1));
        float sunVis = traceShadowRay(midP, sunDir, 10000.0);
        sunRadiance = sun.color.rgb * sun.color.a * sunVis * 0.022;
    }
    vec3 ambient = settings.skyAmbient.rgb * settings.skyAmbient.a + vec3(0.008);

    uint dynamicStart = settings.lightGridCounts.w;

    // Noise advection: fireballs churn fast, smoke billows slowly upward.
    // The noise domain contracts as the volume expands so the billow
    // features ride outward with the boundary instead of swimming in place.
    float churn = (emissivePower > 0.0) ? 2.6 : 0.55;
    vec3 noiseDrift = vec3(0.0, 0.0, -churn * age) + vec3(seed);
    float expansion = (emissivePower > 0.0) ? smoothstep(0.0, 0.30, life) : life;
    float domainScale = (emissivePower > 0.0) ? (3.6 - 1.3 * expansion)
                                              : (2.9 - 0.9 * expansion);
    float tear = mix(0.42, 0.85, (emissivePower > 0.0) ? smokePhase : life);

    // Slow roll about the rise axis
    float rollAng = age * ((emissivePower > 0.0) ? 0.9 : 0.35);
    float rc = cos(rollAng), rs = sin(rollAng);
    mat2 roll = mat2(rc, -rs, rs, rc);

    // Self-shadow tap direction toward the sun in the rolled local frame
    // (local space is uniformly scaled, so directions carry over; rolling
    // it keeps the taps consistent with the rotating noise domain)
    vec3 sunLocal = sunDir;
    sunLocal.xy = roll * sunLocal.xy;

    vec3 scatter = vec3(0.0);
    float transmittance = 1.0;
    float t = t0 + stepLen * ign;

    for (int i = 0; i < FX_STEPS; i++) {
        vec3 p = origin + dir * t;
        vec3 local = (p - center) / radius;
        float radial = length(local);

        if (radial < 1.0) {
            vec3 noiseLocal = local;
            noiseLocal.xy = roll * noiseLocal.xy;

            float n;
            float field = vfxField(local, noiseLocal, noiseDrift, domainScale, tear, n);

            float sigma = sigmaScale * smokeDensityFade * field;
            if (sigma > 1e-5) {
                float stepTrans = exp(-sigma * stepLen);
                float a = 1.0 - stepTrans;

                vec3 stepRadiance = vec3(0.0);

                // Emissive fireball: blackbody-style ramp driven by a heat
                // field (hot noise pockets in a cooling core), with the
                // detonation flash on top
                float core = smoothstep(0.9, 0.12, radial);
                if (emissivePower > 0.0 && fireT > 0.0) {
                    float heat = fireT * (0.30 + 0.70 * core) * (0.25 + 0.75 * n);
                    vec3 fireColor = isEnergy ? vfxEnergyRamp(heat, v.emission.rgb)
                                              : vfxFireRamp(heat, v.emission.rgb);
                    // heat^2 keeps the ramp readable: only the true core
                    // saturates, the mantle stays orange/red and textured
                    stepRadiance += fireColor * (emissivePower * flash * heat * heat *
                                                 (0.30 + 1.1 * core) * (0.30 + 0.70 * fireT));
                }

                // Lit smoke: sun (self-shadowed by the volume itself), sky
                // ambient, nearby dynamic lights, and the fireball's own
                // glow scattering out through the shroud. Soot builds up
                // gradually through the burn so the young fireball is not
                // capped by a dark shroud.
                float smokeAmount = (emissivePower > 0.0)
                    ? smoothstep(0.35, 1.0, 1.0 - fireT) * (0.35 + 0.65 * n)
                    : 1.0;
                if (smokeAmount > 0.0) {
                    vec3 albedo = (emissivePower > 0.0)
                        ? mix(vec3(0.09, 0.08, 0.075), vec3(0.20, 0.19, 0.18), smokePhase)
                        : v.emission.rgb;

                    // Two cheap density taps toward the sun give the smoke
                    // its 3D form: sunlit tops, shadowed undersides
                    float occ = vfxFieldCheap(noiseLocal + sunLocal * 0.18,
                                              noiseDrift, domainScale, tear)
                              + vfxFieldCheap(noiseLocal + sunLocal * 0.45,
                                              noiseDrift, domainScale, tear);
                    float selfShadow = exp(-occ * sigmaScale * radius * 0.55);

                    vec3 lighting = ambient * mix(0.55, 1.0, selfShadow)
                                  + sunRadiance * selfShadow;
                    for (uint li = dynamicStart; li < lightData.numLights; li++) {
                        Light dl = lightData.lights[li];
                        if (dl.position.w != 1.0) {
                            continue;
                        }
                        vec3 toLight = dl.position.xyz - p;
                        float dist = length(toLight);
                        if (dist < 1e-3) {
                            continue;
                        }
                        float att = computeAttenuation(dist, dl.attenuation.xyz);
                        lighting += dl.color.rgb * dl.color.a * att * 0.03;
                    }

                    // Interior glow: while the core burns, it lights the
                    // surrounding smoke from within
                    if (emissivePower > 0.0 && fireT > 0.0) {
                        vec3 glowColor = isEnergy ? v.emission.rgb
                                                  : vec3(1.0, 0.55, 0.16);
                        lighting += glowColor * (emissivePower * 0.05 * fireT *
                                                 smoothstep(1.0, 0.15, radial));
                    }

                    stepRadiance += albedo * lighting * smokeAmount;
                }

                scatter += transmittance * stepRadiance * a;
                transmittance *= stepTrans;
                if (transmittance < 0.02) {
                    break;
                }
            }
        }
        t += stepLen;
    }

    outTrans = transmittance;
    return scatter;
}

/*
================
Volumetric in-scattering along the primary ray: sun/skylight marched with
real shadow rays (light shafts through openings), dynamic effect lights
added analytically so rockets and explosions glow in the air.
Returns in-scattered radiance; transmittance is returned via outTrans.
================
*/
vec3 marchVolumetric(vec3 origin, vec3 dir, float tMax, inout uint seed, out float outTrans) {
    outTrans = 1.0;

    float density = settings.volumetricParams.x;
    if (settings.volumetricParams.w < 0.5 || density <= 0.0) {
        return vec3(0.0);
    }

    const int STEPS = 16;
    float marchEnd = min(tMax, settings.volumetricParams.z);
    if (marchEnd < 1.0) {
        return vec3(0.0);
    }

    float g = settings.volumetricParams.y;
    float stepLen = marchEnd / float(STEPS);
    // In-scatter brightness is calibrated separately from extinction so a
    // fully sun-lit march (open sky) stays below the sky's own luminance.
    float scatterScale = settings.featureParams.z;

    // Sun = first directional light in the grid's directional list
    bool haveSun = settings.lightGridCounts.x > 0u;
    vec3 sunDir = vec3(0.0, 0.0, 1.0);
    vec3 sunRadiance = vec3(0.0);
    float sunPhase = 0.25 * INV_PI;
    if (haveSun) {
        Light sun = lightData.lights[lightGridIndices.indices[0]];
        sunDir = normalize(-sun.direction.xyz);
        sunRadiance = sun.color.rgb * sun.color.a;
        // Henyey-Greenstein phase for the (constant) sun direction
        float cosTheta = dot(dir, sunDir);
        float g2 = g * g;
        sunPhase = 0.25 * INV_PI * (1.0 - g2) / pow(max(1.0 + g2 - 2.0 * g * cosTheta, 1e-3), 1.5);
    }

    uint dynamicStart = settings.lightGridCounts.w;

    vec3 scatter = vec3(0.0);
    float transmittance = 1.0;
    // Interleaved gradient noise: spatially smooth dither the à-trous chain
    // filters far better than white noise
    vec2 px = vec2(gl_LaunchIDEXT.xy);
    float ign = fract(52.9829189 * fract(0.06711056 * px.x + 0.00583715 * px.y));
    float t = stepLen * ign;

    for (int i = 0; i < STEPS; i++) {
        vec3 p = origin + dir * t;
        float stepScatter = density * stepLen;

        if (haveSun) {
            float vis = traceShadowRay(p, sunDir, 10000.0);
            scatter += transmittance * sunRadiance * (vis * sunPhase * stepScatter * scatterScale);
        }

        // Dynamic effect lights (few): analytic in-scatter, no shadow rays
        for (uint li = dynamicStart; li < lightData.numLights; li++) {
            Light dl = lightData.lights[li];
            if (dl.position.w != 1.0) {
                continue;
            }
            vec3 toLight = dl.position.xyz - p;
            float dist = length(toLight);
            if (dist < 1e-3) {
                continue;
            }
            float att = computeAttenuation(dist, dl.attenuation.xyz);
            scatter += transmittance * dl.color.rgb * dl.color.a *
                       (att * 0.25 * INV_PI * stepScatter * scatterScale * 4.0);
        }

        transmittance *= exp(-density * stepLen);
        t += stepLen;
    }

    outTrans = transmittance;
    return scatter;
}

void main() {
    const vec2 pixelCenter = vec2(gl_LaunchIDEXT.xy) + vec2(0.5);
    const vec2 inUV = pixelCenter / vec2(gl_LaunchSizeEXT.xy);

    // Initialize random seed for this pixel
    uint pixelIndex = gl_LaunchIDEXT.y * gl_LaunchSizeEXT.x + gl_LaunchIDEXT.x;
    uint rngSeed = pixelIndex + cam.frameCount * 733;

    vec3 finalColor = vec3(0.0);
    vec3 finalAlbedo = vec3(0.0);
    vec3 finalNormal = vec3(0.0);
    float finalDepth = 1.0;
    vec3 finalDirectLight = vec3(0.0);
    vec3 finalIndirectLight = vec3(0.0);
    vec3 firstHitWorldPos = vec3(0.0);
    float firstHitValid = 0.0;
    float primaryHitT = cam.farPlane;

    uint samples = max(cam.samplesPerPixel, 1u);
    uint maxBounces = max(cam.maxBounces, 1u);

    for (uint s = 0; s < samples; s++) {
        // Anti-aliasing jitter
        vec2 jitter = vec2(randomFloat(rngSeed) - 0.5, randomFloat(rngSeed) - 0.5) / vec2(gl_LaunchSizeEXT.xy);
        vec2 d = (inUV + jitter) * 2.0 - 1.0;
        // The engine projection is GL-convention (Y up) while image rows run
        // top-down; flip Y so the traced image matches the framebuffer.
        d.y = -d.y;

        vec4 target = cam.projInverse * vec4(d.x, d.y, 1.0, 1.0);
        vec3 rayDirView = normalize(target.xyz / target.w);
        vec4 direction = cam.viewInverse * vec4(rayDirView, 0.0);

        vec3 throughput = vec3(1.0);
        vec3 accumulatedColor = vec3(0.0);
        vec3 currentOrigin = cam.position;
        vec3 currentDir = direction.xyz;

        for (uint b = 0; b < maxBounces; b++) {
            traceRayEXT(topLevelAS, gl_RayFlagsOpaqueEXT, 0xff, 0, 0, 0, currentOrigin, 0.001, currentDir, 10000.0, 0);

            if (hitInfo.hitType == 0) {
                // Miss shader returns the map's sky radiance
                accumulatedColor += throughput * hitInfo.color;
                break;
            }

            // Light the surface: emission + sky-derived ambient + shadowed
            // direct lighting evaluated right here at recursion depth 1
            vec3 viewDir = normalize(-currentDir);
            vec3 surfaceColor = hitInfo.color; // emission
            surfaceColor += hitInfo.albedo * settings.skyAmbient.rgb * settings.skyAmbient.a;
            vec3 direct = shadeDirectLighting(hitInfo.worldPos, hitInfo.normal,
                                              hitInfo.albedo, hitInfo.roughness,
                                              hitInfo.metallic, viewDir, rngSeed);

            // Underwater surfaces get the animated caustic modulation
            if (settings.featureParams.x > 0.5 && (hitInfo.materialID & 0x80000000u) != 0u) {
                float caustic = causticPattern(hitInfo.worldPos, cam.time);
                direct *= 0.6 + caustic * settings.featureParams.y;
            }
            surfaceColor += direct;

            // On first hit, store G-buffer data
            if (b == 0) {
                finalAlbedo += hitInfo.albedo;
                finalNormal += hitInfo.normal;
                // Planar eye depth (not radial distance) so the raster
                // depth buffer can be compared against it when compositing
                float planarZ = dot(hitInfo.worldPos - cam.position, normalize(cam.forward));
                finalDepth = min(finalDepth, planarZ / cam.farPlane);
                finalDirectLight += surfaceColor;
                if (firstHitValid == 0.0) {
                    firstHitWorldPos = hitInfo.worldPos;
                    firstHitValid = 1.0;
                    primaryHitT = hitInfo.distance;
                }
            } else {
                finalIndirectLight += throughput * surfaceColor;
            }

            accumulatedColor += throughput * surfaceColor;

            // Choose the next bounce lobe: diffuse or specular. Splitting by
            // Fresnel/metallic is what gives metals mirror reflections and
            // smooth surfaces glossy reflections instead of a flat diffuse
            // bounce. One lobe is sampled per bounce and its throughput is
            // divided by the selection probability (single-sample MIS), which
            // keeps the estimator unbiased.
            vec3 N = hitInfo.normal;
            currentOrigin = hitInfo.worldPos + N * EPSILON;

            // featureParams.w is the reflections toggle (rt_reflections).
            if (settings.featureParams.w < 0.5) {
                // Reflections off: original diffuse-only bounce.
                currentDir = sampleHemisphere(N, rngSeed);
                throughput *= hitInfo.albedo;
            } else {
                float rough = clamp(hitInfo.roughness, 0.02, 1.0);
                float metal = clamp(hitInfo.metallic, 0.0, 1.0);
                float NdotV = max(dot(N, viewDir), 1e-3);

                vec3 F0 = mix(vec3(0.04), hitInfo.albedo, metal);
                vec3 Fr = fresnelSchlick(NdotV, F0);
                // Probability of the specular lobe: driven by reflectance,
                // forced high for metals, clamped so neither lobe starves.
                float pSpec = clamp(max(luminanceRGB(Fr), metal * 0.9), 0.05, 0.95);

                if (randomFloat(rngSeed) < pSpec) {
                    // Specular lobe: reflect about a VNDF-sampled microfacet,
                    // or a perfect mirror for very smooth surfaces.
                    vec3 L;
                    if (rough <= 0.05) {
                        L = reflect(currentDir, N);
                        throughput *= Fr / pSpec;         // mirror weight = F
                    } else {
                        vec3 H = sampleGGXVNDF(N, viewDir, rough, rngSeed);
                        L = reflect(currentDir, H);
                        float NdotL = dot(N, L);
                        if (NdotL <= 0.0) break;   // reflected below the surface
                        float VdotH = max(dot(viewDir, H), 1e-3);
                        vec3 F = fresnelSchlick(VdotH, F0);
                        // VNDF weight = F * G1(L); D and G1(V) cancel the pdf.
                        float G1L = geometrySchlickGGX(NdotL, rough);
                        throughput *= (F * G1L) / pSpec;
                    }
                    currentDir = L;
                } else {
                    // Diffuse lobe: cosine-weighted, none for pure metals.
                    currentDir = sampleHemisphere(N, rngSeed);
                    throughput *= (hitInfo.albedo * (1.0 - metal)) / (1.0 - pSpec);
                }
            }

            // Roulette termination
            if (b > 2) {
                float p = max(throughput.r, max(throughput.g, throughput.b));
                if (randomFloat(rngSeed) > p) break;
                throughput /= p;
            }

            // A non-finite origin or direction hard-faults ray traversal;
            // validate before tracing again.
            if (any(isnan(currentOrigin)) || any(isinf(currentOrigin)) ||
                any(isnan(currentDir)) || any(isinf(currentDir)) ||
                dot(currentDir, currentDir) < 0.5) {
                break;
            }
        }
        // Firefly clamp: bound rare high-energy samples so single-pixel
        // sparkles do not survive the tonemapper.
        finalColor += min(accumulatedColor, vec3(6.0));
    }

    finalColor /= float(samples);
    finalAlbedo /= float(samples);
    finalNormal = normalize(finalNormal);
    finalDirectLight /= float(samples);
    finalIndirectLight /= float(samples);

    // Volumetric media along the primary view segment: homogeneous fog plus
    // the volumetric weapon effects (explosion fireballs, smoke). Computed
    // once per pixel; the temporal pass smooths the dithered march.
    {
        vec2 dCenter = inUV * 2.0 - 1.0;
        dCenter.y = -dCenter.y;
        vec4 targetC = cam.projInverse * vec4(dCenter.x, dCenter.y, 1.0, 1.0);
        vec3 viewRay = normalize((cam.viewInverse * vec4(normalize(targetC.xyz / targetC.w), 0.0)).xyz);

        float mediaTrans;
        vec3 mediaScatter = marchVolumetric(cam.position, viewRay, primaryHitT, rngSeed, mediaTrans);

        uint fxCount = min(volumeFX.countPad.x, 64u);
        if (fxCount > 0u) {
            vec2 px = vec2(gl_LaunchIDEXT.xy);
            float ign = fract(52.9829189 * fract(0.06711056 * px.x + 0.00583715 * px.y));
            float fogDensity = (settings.volumetricParams.w > 0.5) ? settings.volumetricParams.x : 0.0;

            int marched = 0;
            for (uint f = 0u; f < fxCount; f++) {
                float fxTrans;
                vec3 fxScatter = marchVolumeEffect(int(f), cam.position, viewRay,
                                                   primaryHitT, ign, fxTrans);
                if (fxTrans < 0.999 || any(greaterThan(fxScatter, vec3(0.0)))) {
                    // Attenuate the effect by the fog in front of it
                    float dc = length(volumeFX.fx[f].posRadius.xyz - cam.position);
                    float fogA = exp(-fogDensity * min(dc, settings.volumetricParams.z));
                    mediaScatter += fxScatter * fogA;
                    mediaTrans *= fxTrans;
                    // Safety valve: past this many overlapping volumes the
                    // extra terms are visually negligible
                    if (++marched >= 8) {
                        break;
                    }
                }
            }
        }

        // Media is NOT folded into the traced color: the denoiser would
        // smear the volume detail (it has no G-buffer edges to protect it).
        // The composite applies it after denoising, to traced and raster
        // pixels alike, so fireball and smoke structure survives intact.
        imageStore(mediaImage, ivec2(gl_LaunchIDEXT.xy), vec4(mediaScatter, mediaTrans));
    }

    // Output stays LINEAR HDR: the despeckle chain (rt_denoise.comp)
    // filters the radiance and applies tonemap + gamma in its final pass.

    // Store outputs
    imageStore(image, ivec2(gl_LaunchIDEXT.xy), vec4(finalColor, 1.0));
    imageStore(albedoImage, ivec2(gl_LaunchIDEXT.xy), vec4(finalAlbedo, 1.0));
    imageStore(normalImage, ivec2(gl_LaunchIDEXT.xy), vec4(finalNormal * 0.5 + 0.5, 1.0));
    imageStore(depthImage, ivec2(gl_LaunchIDEXT.xy), vec4(finalDepth, 0.0, 0.0, 1.0));
    // First-hit world position feeds the temporal reprojection pass
    imageStore(motionVectorImage, ivec2(gl_LaunchIDEXT.xy), vec4(firstHitWorldPos, firstHitValid));
    imageStore(directLightImage, ivec2(gl_LaunchIDEXT.xy), vec4(finalDirectLight, 1.0));
    imageStore(indirectLightImage, ivec2(gl_LaunchIDEXT.xy), vec4(finalIndirectLight, 1.0));
}
